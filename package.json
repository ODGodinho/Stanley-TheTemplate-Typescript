{
    "name": "stanley-the-template-typescript",
    "version": "0.0.0",
    "description": "Stanley TheTemplate for typescript project",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "homepage": "https://github.com/ODGodinho/Stanley-TheTemplate-Typescript",
    "imports": {
        "#types": "./@types/index.d.ts",
        "#app/*": "./src/app/*",
        "#configs": "./src/Configs/index.ts",
        "#configs/*": "./src/Configs/*",
        "#enums": "./src/app/Enums/index.ts",
        "#enums/*": "./src/app/Enums/*",
        "#exceptions": "./src/Exceptions/index.ts",
        "#exceptions/*": "./src/Exceptions/*",
        "#factory": "./src/app/Factory/index.ts",
        "#factory/*": "./src/app/Factory/*",
        "#interfaces": "./src/Interfaces/index.ts",
        "#interfaces/*": "./src/Interfaces/*",
        "#kernel": "./src/Kernel/index.ts",
        "#kernel/*": "./src/Kernel/*",
        "#listeners": "./src/app/Listeners/index.ts",
        "#listeners/*": "./src/app/Listeners/*",
        "#validators": "./src/Validators/index.ts",
        "#validators/*": "./src/Validators/*",
        "#providers": "./src/app/Providers/index.ts",
        "#providers/*": "./src/app/Providers/*",
        "#services": "./src/app/Services/index.ts",
        "#services/*": "./src/app/Services/*"
    },
    "scripts": {
        "build": "rimraf dist/ && bun run tsc:build && bun run tsc:alias",
        "build:watch": "concurrently 'bun run tsc:build -w' 'bun run tsc:alias -w'",
        "clean": "rimraf dist/ node_modules/",
        "dev": "bun ./src/index.ts",
        "start": "bun ./dist/index.js",
        "lint": "odg-lint",
        "lint:fix": "odg-lint --fix",
        "prepare": "husky",
        "reset": "bun run clean && bun install && bun run build",
        "test": "vitest run",
        "test:unit": "vitest run --project unit --coverage.enabled=false",
        "test:ci": "vitest run --passWithNoTests",
        "test:watch": "vitest --watch",
        "tsc:check": "tsc --noEmit -p tsconfig.json",
        "tsc:build": "tsc --project ./tsconfig.build.json",
        "tsc:alias": "tsc-alias"
    },
    "engines": {
        "node": ">=26.0.0",
        "bun": ">=1.4.0"
    },
    "packageManager": "bun@1.4.0",
    "publishConfig": {
        "access": "public"
    },
    "lint-staged": {
        "*": "bun run lint:fix"
    },
    "release": {
        "branches": [
            "+([0-9])?(.{+([0-9]),x}).x",
            "main",
            "master",
            "next",
            "next-major",
            {
                "name": "beta",
                "prerelease": true
            },
            {
                "name": "alpha",
                "prerelease": true
            }
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/npm",
            "@semantic-release/github"
        ]
    },
    "files": [
        "./dist/",
        "./README.md"
    ],
    "author": "Dragons Gamers <https://www.linkedin.com/in/victor-alves-odgodinho>",
    "license": "MIT",
    "devDependencies": {
        "@odg/eslint-config": "^3.17.0",
        "@odg/tsconfig": "1.9.0",
        "@types/node": ">=26.3.0",
        "@vitest/coverage-istanbul": "^4.1.11",
        "bun-types": "^1.4.0",
        "concurrently": "^10.0.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "rimraf": "^6.1.3",
        "tsc-alias": "^1.9.2",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@inversifyjs/binding-decorators": "^3.0.0",
        "@inversifyjs/strongly-typed": "^3.0.0",
        "@odg/axios": "^1.27.0",
        "@odg/chemical-x": "^2.18.0",
        "@odg/config": "^1.13.4",
        "@odg/events": "^1.12.9",
        "@odg/exception": "^1.19.3",
        "@odg/json-log": "^1.19.0",
        "@odg/log": "^1.20.0",
        "@odg/message": "^1.27.0",
        "inversify": "^8.2.3",
        "reflect-metadata": "^0.2.2",
        "zod": "^4.4.3"
    }
}
